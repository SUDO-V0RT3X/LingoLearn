PORT=4000
# The one database. Local docker (backend/docker-compose.yml) or the hosted one.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/lingolearn
# DATABASE_SSL=true   # only for a hosted Postgres that requires TLS
# Signing secret for session tokens. Required: the server refuses to issue or
# verify a token without it. Any long random string works locally.
AUTH_SECRET=change-me-in-your-own-env
# Only behind a reverse proxy: how many proxy hops to trust for the client IP
# (e.g. 1), or 'loopback'. Leave unset locally; never 'true' (it lets clients
# spoof their IP and dodge the sign-in rate limits).
# TRUST_PROXY=1
# Minutes a learner waits after failing a level-up challenge (default 60).
# The live demo uses 2 so a failed challenge can be retried on the day.
# CHALLENGE_COOLDOWN_MINUTES=2
